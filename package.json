{
  "name": "cruor-games",
  "private": true,
  "version": "17.0.0a",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test": "vitest",
    "test:run": "vitest run",
    "test:ui": "vitest --ui",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:browsers:install": "playwright install chromium firefox",
    "test:design-system": "playwright test tests/e2e/design-system",
    "test:visual:design-system": "playwright test tests/e2e/design-system --grep @visual",
    "test:visual:design-system:update": "playwright test tests/e2e/design-system --grep @visual --update-snapshots",
    "test:scrollbars:design-system": "playwright test tests/e2e/design-system/scrollbars.spec.js tests/e2e/design-system/scroll-owners.spec.js",
    "test:e2e:dark-places": "playwright test tests/e2e/dark-places-pipeline.spec.js",
    "test:e2e:dark-places:headed": "playwright test tests/e2e/dark-places-pipeline.spec.js --headed",
    "qa:dark-places": "npm run test:e2e:dark-places",
    "qa:dark-places:acceptance": "node scripts/run-dark-places-acceptance-qa.mjs",
    "qa:dark-places:full": "npm run qa:dark-places:acceptance && npm run qa:circle-connectors && npm run qa:maps:debug && npm run test:run && npm run build",
    "diagnose:workbench": "node scripts/diagnose-workbench-scroll.mjs",
    "test:all": "npm run build && npm run test:run && npm run test:e2e",
    "content:validate": "node scripts/validate-content-registry.mjs",
    "content:export": "node scripts/export-content-registry.mjs",
    "vscode:clutter": "node .vscode/dev/toggle-vscode-clutter.mjs",
    "git:auto-update": "node .vscode/dev/git-auto-update.mjs",
    "git:main": "node .vscode/dev/git-auto-update.mjs main",
    "git:feature": "node .vscode/dev/git-auto-update.mjs feature",
    "git:fix": "node .vscode/dev/git-auto-update.mjs fix",
    "git:experiment": "node .vscode/dev/git-auto-update.mjs experiment",
    "git:restore-main": "node .vscode/dev/git-restore-from-github.mjs main",
    "git:restore-current": "node .vscode/dev/git-restore-from-github.mjs current",
    "monster:qa": "node --import ./scripts/register-svg-loader.mjs scripts/run-monster-qa.mjs",
    "qa:all": "npm run content:validate && npm run content:export && npm run monster:qa && npm run qa:composer-assignment && npm run qa:room-design && npm run qa:room-design-gallery && npm run qa:map-archetypes && npm run qa:maps && npm run qa:circle-connectors && npm run test:run",
    "qa:maps": "node scripts/run-map-qa.mjs --count=250 --mode=realistic",
    "qa:maps:debug": "node scripts/run-map-qa.mjs --count=250 --mode=debug",
    "qa:maps:adapters": "node scripts/run-map-qa.mjs --adapter-qa --count=250 --mode=debug --determinism=off",
    "qa:composer-assignment": "node scripts/run-composer-assignment-qa.mjs",
    "qa:map-archetypes": "node scripts/run-map-archetype-qa.mjs",
    "qa:map-archetype-gallery": "node scripts/run-map-archetype-gallery.mjs",
    "qa:room-design": "node scripts/run-room-design-qa.mjs",
    "qa:room-design-gallery": "node scripts/run-room-design-gallery.mjs",
    "qa:circle-connectors": "vitest run --config scripts/vitest.circle-connectors.config.mjs --reporter=default",
    "docs:repo-map": "node scripts/repository-map/generate-repository-map.mjs",
    "docs:repo-map:check": "node scripts/repository-map/validate-repository-map.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "framer-motion": "^12.40.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^6.0.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.60.0",
    "@vitest/ui": "^4.1.7",
    "eslint": "^10.4.0",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "playwright": "^1.60.0",
    "prettier": "^3.8.3",
    "vitest": "^4.1.7"
  }
}
